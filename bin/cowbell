#!/bin/sh
# cowbell launcher — pick a python >= 3.11 (tomllib), then exec the module.
# macOS /usr/bin/python3 is 3.9 and silently fails on modern syntax; the
# fleet venv is preferred, homebrew next, bare python3 last.
here="$(cd "$(dirname "$0")/.." && pwd)"
for py in "$HOME/.venvs/fleet/bin/python3" /opt/homebrew/bin/python3 /usr/local/bin/python3 python3; do
  if command -v "$py" >/dev/null 2>&1 \
     && "$py" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null; then
    exec "$py" "$here/cowbell.py" "$@"
  fi
done
echo "cowbell: no python >= 3.11 found (need tomllib)" >&2
exit 2
